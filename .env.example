# 复制为根目录 .env，填写真实配置；该文件不含可用密码。
WEB_PORT=8090
# 公网部署使用 compose.production.yaml；只填域名，例如 shop.your-company.cn。
PAW_DOMAIN=
ACME_EMAIL=
MYSQL_ROOT_PASSWORD=
PAW_DB_PASSWORD=
PAW_REDIS_PASSWORD=
PAW_ADMIN_PASSWORD=
# JWT 签名密钥，至少 32 字节；order-server 与 admin-server 共用，更换后所有用户需重新登录。
PAW_JWT_SECRET=
# base64 编码的至少 32 字节随机数据。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_VALUE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
# 小程序 wx.login 专用配置；AppSecret 仅保存在服务端。
PAW_WECHAT_MINI_APP_ID=
PAW_WECHAT_MINI_APP_SECRET=
# 微信支付使用的公众号 AppID。
PAW_WECHAT_APP_ID=
# 阿里云号码认证控制台「图形认证方案」生成的 appId、appKey（不是 AccessKey）。
PAW_CAPTCHA_APP_ID=
PAW_CAPTCHA_APP_KEY=
PAW_SMS_ACCESS_KEY_ID=
PAW_SMS_ACCESS_KEY_SECRET=
# 未配置短信专用密钥时，后端成对使用以下阿里云凭据。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
PAW_OSS_ENABLED=false
PAW_OSS_BUCKET=
PAW_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
PAW_PNVS_SIGN_NAME=恒创联众
PAW_PNVS_LOGIN_TEMPLATE=100001
PAW_SMS_SIGN_NAME=
PAW_SMS_CONFIRM_TEMPLATE=
PAW_SMS_APPOINTMENT_SUBMITTED_TEMPLATE=
PAW_SMS_APPOINTMENT_CONFIRMED_TEMPLATE=
PAW_SMS_APPOINTMENT_CANCELLED_TEMPLATE=
PAW_SMS_APPOINTMENT_EXPIRED_TEMPLATE=
PAW_SMS_APPOINTMENT_COMPLETED_TEMPLATE=
