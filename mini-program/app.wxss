/* 与上午设计一致的奶油白、暖橙、圆角与安全区；系统导航由微信绘制。 */
page{background:#FBF8F3;color:#2B2724;font-size:27rpx;line-height:1.6}
view,text,input,textarea,button{box-sizing:border-box}
button{margin:0;padding:0;font-size:27rpx;border-radius:24rpx;line-height:1.5}button::after{border:0}
.page{padding:36rpx 38rpx 40rpx}.with-footer{padding-bottom:calc(170rpx + env(safe-area-inset-bottom))}
.title{font-size:44rpx;font-weight:700;line-height:1.4;margin-bottom:20rpx}.subtitle,.muted{color:#827A70;font-size:24rpx}
.panel{background:#fff;border-radius:38rpx;padding:30rpx;margin-bottom:24rpx}.row{display:flex;align-items:center;gap:22rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.heading{font-size:32rpx;font-weight:600}.brand,.price{color:#B9512B}.price{font-size:40rpx;font-weight:700}.small{font-size:22rpx}.caption{color:#827A70;font-size:22rpx;line-height:1.6}
.btn{background:#B9512B;color:white;min-height:92rpx;display:flex;align-items:center;justify-content:center;padding:22rpx 28rpx;border-radius:22rpx;font-weight:500}
/* v2 原生按钮默认宽度较小；页面主操作与整行入口使用容器全宽。 */
.page .btn,.footer .btn,.page .link-row{width:100%}
.page .text-btn{width:auto}
.btn[disabled]{background:#E4DBD0;color:#827A70}.secondary{background:#fff;color:#B9512B;border:1rpx solid #E4DBD0}.text-btn{background:transparent;color:#B9512B;padding:12rpx;font-size:24rpx}
.footer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:22rpx 38rpx calc(22rpx + env(safe-area-inset-bottom));z-index:5}
.notice{padding:22rpx 24rpx;border-radius:22rpx;background:#F7E4D3;color:#B9512B;font-size:23rpx;margin:24rpx 0}.neutral{background:#F1ECE3;color:#827A70}.demo-note{text-align:center;color:#827A70;font-size:21rpx;margin:26rpx 0 8rpx}
.search{display:flex;align-items:center;gap:18rpx;background:white;border-radius:60rpx;padding:18rpx 28rpx;margin:26rpx 0}.search input{flex:1;min-width:0;font-size:25rpx;height:48rpx}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.tabs{display:flex;gap:16rpx;margin:24rpx 0}.tab{flex:1;background:#fff;border-radius:40rpx;text-align:center;padding:16rpx 8rpx;color:#746B63;font-size:25rpx}.tab.active{background:#F7E4D3;color:#B9512B}
.field{margin-top:22rpx}.label{display:block;color:#827A70;font-size:24rpx;margin-bottom:8rpx}.input{background:#FBF8F3;border-radius:24rpx;padding:20rpx 24rpx;min-height:88rpx;width:100%;font-size:27rpx}.check{display:flex;align-items:center;gap:10rpx;font-size:23rpx;color:#746B63;margin:26rpx 0}.check checkbox{transform:scale(.8)}
.summary-image{width:154rpx;height:162rpx;border-radius:24rpx;flex:none}.badge{background:#F7E4D3;color:#B9512B;border-radius:40rpx;font-size:23rpx;padding:12rpx 28rpx}.link-row{width:100%;text-align:left;background:#fff;border-radius:38rpx;padding:26rpx 30rpx;margin-bottom:22rpx;display:flex;align-items:center;justify-content:space-between}.link-icon{color:#B9512B;font-size:38rpx;margin-right:24rpx}.arrow{color:#827A70;font-size:36rpx}
.pre{white-space:pre-wrap;word-break:break-word}.spacer{height:24rpx}
