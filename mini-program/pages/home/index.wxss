/* 快捷入口使用等宽 flex，避免原生按钮的默认宽度撑出容器。 */
.page{padding-top:16rpx}.search{margin:0 0 24rpx;height:86rpx}.hero{display:flex;gap:22rpx;background:#F7E4D3;border-radius:38rpx;padding:30rpx;align-items:center}.hero-copy{flex:1;min-width:0}.eyebrow{font-size:17rpx;color:#B9512B}.hero-title{font-size:46rpx;font-weight:700;line-height:1.5;margin:20rpx 0}.hero-photo{width:277rpx;height:338rpx;border-radius:38rpx;flex:none}.hero-button{margin-top:16rpx;padding:14rpx 16rpx;min-height:76rpx;font-size:25rpx;width:100%;max-width:100%}.shortcuts{display:flex;gap:22rpx;margin-top:24rpx}.shortcut{display:flex;align-items:center;flex:1;width:0;min-width:0;background:#fff;border-radius:38rpx;padding:22rpx 20rpx;text-align:left;font-size:26rpx;min-height:130rpx}.shortcut .link-icon{margin-right:16rpx;flex:none}.shortcut .caption{font-size:18rpx}.green{background:#E8F0E8}.green .link-icon{color:#426B5E}.section{margin:24rpx 0}
