<view class="page"><view class="search" bindtap="browse"><text class="muted">⌕　想找哪位小伙伴？</text></view><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><view wx:if="{{shop}}"><view class="hero"><view class="hero-copy"><text class="eyebrow">HELLO, LITTLE PAW</text><view class="hero-title"><view>把喜欢，</view><view>变成陪伴。</view></view><view class="caption">先见一面，再认真决定。</view><button class="btn hero-button" bindtap="browse">去认识它们 →</button></view><image wx:if="{{hero}}" class="hero-photo" src="{{hero.coverUrl}}" mode="aspectFill"/></view><view class="shortcuts"><button class="shortcut" bindtap="assistant"><text class="link-icon">✧</text><view><view>养宠助手</view><text class="caption">新手问题，随时问</text></view></button><button class="shortcut green" bindtap="shop"><text class="link-icon">⌖</text><view><view>到店见一面</view><text class="caption">{{shop.businessHours}}</text></view></button></view><view class="between section"><text class="heading">今日的小心动</text><button class="text-btn" bindtap="browse">全部宠物 →</button></view><view class="grid"><pet-card class="pet-card" wx:for="{{pets}}" wx:key="id" pet="{{item}}"/></view><view wx:if="{{!pets.length}}" class="panel muted">暂时没有推荐宠物，去选宠页看看吧。</view></view><view class="demo-note">{{demo ? '示例宠物 · 本地演示 · 模拟微信身份' : '茸茸星球 · 练习项目'}}</view></view>
