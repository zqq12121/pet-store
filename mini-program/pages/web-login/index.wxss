.web-login{padding:72rpx 32rpx}.card{padding:48rpx 32rpx;background:#fff;border-radius:28rpx;display:flex;flex-direction:column;gap:32rpx}.heading{font-size:40rpx;font-weight:600;text-align:center}.description{font-size:26rpx;line-height:1.8;color:#746B63}.code{font-size:64rpx;font-weight:600;letter-spacing:12rpx;text-align:center}.consent{display:flex;align-items:center;font-size:26rpx;line-height:1.6}.confirm{background:#B9512B;color:#fff}.card button{width:100%;min-height:88rpx;padding:22rpx 24rpx;font-size:28rpx;display:flex;align-items:center;justify-content:center}.error{color:#B9512B;font-size:26rpx;overflow-wrap:anywhere}.result{font-size:30rpx;line-height:1.8;text-align:center}
