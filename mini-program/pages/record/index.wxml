<view class="page"><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><block wx:if="{{order}}"><view class="title">{{order.statusText}}</view><view class="subtitle">{{order.status === 'pending_confirmation' ? '门店确认后，请按约定时间到店。' : '预约状态以门店安排为准。'}}</view><view class="spacer"/><view class="panel row"><image class="summary-image" src="{{order.product.coverUrl}}" mode="aspectFill"/><view><view class="heading">{{order.product.name}} · {{order.product.breed}}</view><view class="brand">参考价 {{order.priceText}}</view><view class="caption">到店付款 · 线上不收款</view></view></view><view class="panel"><view class="heading">到店安排</view><view class="spacer"/><view>◷　{{order.visitText}}</view><view class="caption">联系人：{{order.contactName}}　{{order.contactPhoneMasked}}</view><view class="caption">预约编号：{{order.orderNo}}</view><view class="caption" wx:if="{{order.remark}}">备注：{{order.remark}}</view></view><view class="panel"><view class="heading">{{order.shopSnapshot.name}}</view><view class="caption">{{order.shopSnapshot.address}}</view><view class="caption">{{order.shopSnapshot.businessHours}}</view><button class="text-btn" bindtap="shop">查看到店指南 →</button></view><view class="notice neutral">请携带身份证，到店核验宠物档案。</view><button wx:if="{{order.canCancel}}" class="btn secondary" bindtap="cancel" disabled="{{cancelling}}">{{cancelling ? '正在取消…' : '取消预约'}}</button><button class="text-btn" bindtap="records">返回我的预约 →</button><view wx:if="{{demo}}" class="demo-note">DEMO 示例预约 · 仅供测试</view></block></view>
