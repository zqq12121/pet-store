<view class="page"><view class="profile row" bindtap="{{user ? '' : 'login'}}"><view class="avatar">♙</view><view><view class="title">{{user ? user.nickname : '欢迎，新朋友'}}</view><view class="muted">{{user ? '微信账号已登录' : '登录后查看预约安排'}}</view><view class="caption">和小伙伴的故事，从这里开始</view></view></view><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><view class="panel counts"><view data-tab="pending_confirmation" bindtap="records"><text>{{counts[0]}}</text>待确认</view><view data-tab="reservation_confirmed" bindtap="records"><text>{{counts[1]}}</text>待到店</view><view data-tab="completed" bindtap="records"><text>{{counts[2]}}</text>已完成</view></view><button class="link-row" bindtap="records"><view class="row"><text class="link-icon">♧</text><view><view>预约记录</view><view class="caption">查看预约进度与到店安排</view></view></view><text class="arrow">›</text></button><button class="link-row" bindtap="shop"><view class="row"><text class="link-icon">⌖</text><view><view>到店指南</view><view class="caption">营业时间与携带材料</view></view></view><text class="arrow">›</text></button><button class="link-row" bindtap="assistant"><view class="row"><text class="link-icon">✧</text><view><view>养宠助手</view><view class="caption">让新手养宠更有底气</view></view></view><text class="arrow">›</text></button><button class="link-row" bindtap="login" wx:if="{{!user}}"><view>微信登录</view><text class="arrow">›</text></button><button class="text-btn" wx:if="{{user}}" bindtap="logout">退出登录</button><view class="demo-note">茸茸星球 · {{demo ? '本地演示' : '练习项目'}}</view></view>
