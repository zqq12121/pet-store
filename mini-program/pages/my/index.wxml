<view class="page"><view class="profile row" bindtap="{{user ? '' : 'login'}}"><view class="avatar">♙</view><view><view class="title">{{user ? user.nickname : '欢迎，新朋友'}}</view><view class="muted">{{user ? '微信账号已登录' : '登录后收藏喜欢的小伙伴'}}</view><view class="caption">记录每一份小心动</view></view></view><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><button class="link-row" bindtap="favorites"><view class="row"><text class="link-icon">♡</text><view><view>我的收藏{{user ? ' · ' + count : ''}}</view><view class="caption">查看和管理喜欢的动物</view></view></view><text class="arrow">›</text></button><button class="link-row" bindtap="login" wx:if="{{!user}}"><view>微信登录</view><text class="arrow">›</text></button><button class="text-btn" wx:if="{{user}}" bindtap="logout">退出登录</button><view class="demo-note">茸茸星球 · {{demo ? '本地演示' : '练习项目'}}</view></view>
