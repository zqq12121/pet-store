<view class="page"><view class="title">收藏每一份小心动</view><view class="subtitle">{{loggedIn ? '喜欢的小伙伴，都在这里' : '登录后查看自己的动物收藏'}}</view><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><view class="grid" wx:if="{{loggedIn}}"><view class="favorite-item" wx:for="{{pets}}" wx:key="id"><pet-card wx:if="{{item.available}}" pet="{{item}}"/><view wx:else class="panel unavailable"><text class="heading">已下架动物</text><text class="caption">暂时无法查看档案</text></view><button class="text-btn remove" data-id="{{item.id}}" bindtap="remove" disabled="{{!!removing || loading}}">{{removing === item.id ? '正在取消…' : '取消收藏'}}</button></view></view><!-- 登录失效的错误提示与重新登录入口同时展示。 --><view wx:if="{{!loading && !pets.length && (!loggedIn || !error)}}" class="empty"><view class="empty-symbol">♡</view><view class="heading">{{loggedIn ? '还没有收藏的动物' : '登录后收藏喜欢的动物'}}</view><view class="caption">浏览动物资料，把喜欢的小伙伴留在这里。</view><button class="btn" wx:if="{{!loggedIn}}" bindtap="login">微信登录</button><button class="btn secondary" bindtap="browse">去看看动物</button></view><view class="demo-note" wx:if="{{demo}}">本地演示 · 示例动物 · 收藏仅保存在本机</view></view>
