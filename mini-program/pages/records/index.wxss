.order-product{margin:30rpx 0}.visit{margin-bottom:24rpx}.empty{text-align:center;padding:60rpx 20rpx}.empty-symbol{font-size:110rpx;color:#B9512B}.empty .caption{margin:20rpx 0 36rpx}.empty .btn{margin-top:20rpx}
