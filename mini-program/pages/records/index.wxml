<view class="page"><view class="title">每一次见面，都值得期待</view><view class="subtitle">查看到店安排与确认状态</view><view class="tabs"><button class="tab {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="tab">全部</button><button class="tab {{tab === 'pending_confirmation' ? 'active' : ''}}" data-tab="pending_confirmation" bindtap="tab">待确认</button><button class="tab {{tab === 'reservation_confirmed' ? 'active' : ''}}" data-tab="reservation_confirmed" bindtap="tab">待到店</button></view><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><view wx:for="{{orders}}" wx:key="id" class="panel"><view class="between order-header"><text class="caption order-number">{{item.orderNo}}</text><text class="brand small order-status">{{item.statusText}}</text></view><view class="row order-product"><image class="summary-image" src="{{item.product.coverUrl}}" mode="aspectFill"/><view><view class="heading">{{item.product.name}} · {{item.product.breed}}</view><text class="caption">到店预约 · 线上不收款</text></view></view><view class="visit">◷　{{item.visitText}}</view><button class="btn secondary" data-id="{{item.id}}" bindtap="record">查看预约</button></view><view wx:if="{{!loading && !error && !orders.length}}" class="empty"><view class="empty-symbol">♡</view><view class="heading">{{loggedIn ? '还没有这类预约' : '登录后查看你的预约'}}</view><view class="caption">挑一位合拍的小伙伴，安排一次到店见面。</view><button class="btn" wx:if="{{!loggedIn}}" bindtap="login">微信登录</button><button class="btn {{!loggedIn ? 'secondary' : ''}}" bindtap="browse">去认识小伙伴</button></view><view class="notice neutral" wx:if="{{orders.length}}">预约状态以门店确认结果为准。</view><view class="demo-note" wx:if="{{demo}}">本地演示 · 示例预约仅供测试</view></view>
