<view class="page with-footer"><view class="assistant-intro"><view class="heading">✧　养宠路上，陪你多想一步</view><view class="caption">准备清单、日常照护、到店须知</view></view><view wx:if="{{demo}}" class="demo-note">本地示例回复 · 未调用 DeepSeek</view><load-state loading="{{loading}}" error="{{!ready ? error : ''}}" bind:retry="openSession"/><view wx:if="{{!messages.length && ready}}"><view class="panel"><view class="heading">你好，未来的家人</view><view class="caption">想了解哪位小伙伴，或聊聊养宠准备？</view></view><button class="suggestion" data-question="第一次养柯基，需要准备什么？" bindtap="suggestion">第一次养柯基，需要准备什么？</button><button class="suggestion" data-question="查询我的到店预约" bindtap="suggestion">查询我的到店预约</button></view><view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><view class="pre">{{item.content}}</view><view class="caption" wx:for="{{item.sources}}" wx:for-item="source" wx:key="title">参考：{{source.title}} · {{source.sourceName}}</view><view class="grid" wx:if="{{item.productCards.length}}"><pet-card class="pet-card" wx:for="{{item.productCards}}" wx:for-item="p" wx:key="id" pet="{{p}}"/></view><button wx:for="{{item.orderCards}}" wx:for-item="o" wx:key="orderId" class="text-btn" data-id="{{o.orderId}}" bindtap="record">{{o.productName}} · {{o.nextAction}} →</button><button wx:for="{{item.actions}}" wx:for-item="a" wx:key="type" class="text-btn" data-type="{{a.type}}" data-id="{{a.targetId}}" bindtap="action">{{a.label}} →</button><view class="brand small" wx:if="{{item.role === 'assistant'}}">{{item.disclaimer || 'AI 生成，仅供参考。健康问题建议及时就医。'}}</view></view><view class="notice neutral" wx:if="{{sending}}">正在思考，请稍候…</view><view class="notice" wx:if="{{ready && error}}">{{error}}<button class="text-btn" wx:if="{{canRetry}}" bindtap="retry" disabled="{{sending}}">重试本次问题</button></view><button class="link-row" bindtap="shop"><text>⌖　到店需要准备什么？</text><text class="arrow">›</text></button></view><view class="footer compose"><input class="input" placeholder="说说你的养宠疑问…" maxlength="2000" value="{{input}}" bindinput="input" bindconfirm="submit" confirm-type="send"/><button class="btn" bindtap="submit" disabled="{{sending || !ready || !input}}">✧</button></view>
