<view class="page"><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><block wx:if="{{order}}"><view class="success-icon">✓</view><view class="title centered">预约已提交</view><view class="subtitle centered">{{order.statusText}} · 线上不收款</view><view class="spacer"/><view class="panel"><view class="heading">期待与你和{{order.product.name}}见面</view><view class="spacer"/><view>◷　{{order.visitText}}</view><view class="caption">联系人：{{order.contactName}}　{{order.contactPhoneMasked}}</view><view class="caption">预约编号：{{order.orderNo}}</view></view><view class="notice neutral">请等待门店确认，到店时携带身份证。</view><button class="btn" bindtap="records">查看我的预约</button><button class="text-btn" bindtap="shop">到店指南 →</button><view class="demo-note" wx:if="{{demo}}">本地演示 · 不是真实预约</view></block></view>
