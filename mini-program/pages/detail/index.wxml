<view class="page with-footer"><load-state loading="{{loading}}" error="{{error}}" bind:retry="reload"/><block wx:if="{{pet}}"><image class="cover" src="{{pet.coverUrl}}" mode="aspectFill" bindtap="photos"/><view class="between"><text class="title pet-title">{{pet.name}} · {{pet.breed}}</text></view><view class="muted">{{pet.description}}</view><view class="between price-row"><text class="price">{{pet.priceText}}</text><text class="caption">参考价格</text></view><view class="panel facts"><view>{{pet.ageMonths}}个月<text>年龄</text></view><view>{{pet.genderText}}<text>性别</text></view><view>{{pet.breed}}<text>品种</text></view></view><view class="panel" bindtap="archive"><view class="heading">♧ 成长档案</view><view class="caption archive-text">查看疫苗、驱虫与健康记录。</view><view class="brand small">{{demo ? '模拟资料，仅供测试 · ' : ''}}{{pet.id}}</view><button class="text-btn" bindtap="archive">查看档案 →</button></view><view class="demo-note" wx:if="{{demo}}">本地演示 · 示例宠物</view></block></view><view wx:if="{{pet}}" class="footer"><button class="btn" bindtap="favorite" disabled="{{saving || loading || !pet}}">{{saving ? '正在保存…' : (favorited ? '♥ 已收藏 · 点击取消' : '♡ 收藏这位小伙伴')}}</button></view>
