<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.warmpaw</groupId>
    <artifactId>warmpaw-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>integration-tests</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.warmpaw</groupId>
      <artifactId>order-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.warmpaw</groupId>
      <artifactId>admin-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JDK 21 启动时加载 Mockito，避免依赖受限环境中的动态自附加。 -->
          <argLine>-javaagent:"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
