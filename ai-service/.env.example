# 密钥只在本机配置，不提交 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
# 直接读取两个 Java 服务，避免通过网关回环。只调用白名单 GET 接口。
PAW_CATALOG_URL=http://127.0.0.1:8082
PAW_ORDER_URL=http://127.0.0.1:8081
AI_HOST=127.0.0.1
AI_PORT=8083
AI_DB_PATH=data/ai.sqlite3
# 仅首次导入使用；日常内容由管理后台维护。
AI_KNOWLEDGE_PATH=knowledge/entries.json
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_MODEL_CACHE=data/models
AI_GENERATION_TIMEOUT=30
